{
  "name": "reinamanager",
  "version": "0.32.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev-cdp": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-cdp.ps1",
    "typecheck": "tsc -b --noEmit",
    "format": "oxfmt",
    "lint": "oxlint",
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck",
    "changelog": "git-cliff --bump --unreleased --prepend CHANGELOG.md",
    "changelog:all": "git-cliff -o CHANGELOG.md",
    "changelog:view": "git-cliff --latest",
    "i18n:status": "i18next-cli status",
    "i18n:sync": "i18next-cli sync",
    "i18n:extract": "i18next-cli extract",
    "i18n:defaults": "node scripts/checkI18nDefaults.js",
    "i18n:defaults:write": "node scripts/checkI18nDefaults.js --write-missing"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-charts": "^8.29.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-http": "~2.8.3",
    "@tauri-apps/plugin-shell": "~2.5.0",
    "@tauri-apps/plugin-store": "~2.5.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "@tauri-apps/plugin-window-state": "~2.5.0",
    "@toolpad/core": "^0.16.0",
    "fuse.js": "^7.5.0",
    "html-react-parser": "^5.2.17",
    "i18next": "^26.5.10",
    "i18next-browser-languagedetector": "^8.2.2",
    "marked": "^18.1.1",
    "notistack": "^3.0.2",
    "pathe": "^2.0.3",
    "pinyin-pro": "^3.29.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.8",
    "react-router-dom": "^7.18.4",
    "react-virtuoso": "^4.18.19",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "git-cliff": "^2.14.2",
    "i18next-cli": "=1.58.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "unocss": "^66.11.0",
    "vite": "^8.3.5"
  }
}
